{
  "name": "epson-connect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Epson Expert Connect - API, realtime signaling and call queue",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  }
}
