# ---- Server ----
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins: your Vercel URLs (+ localhost for development)
CORS_ORIGINS=https://your-website.vercel.app,https://your-admin.vercel.app,https://localhost:5173,https://localhost:5174

# ---- MySQL / MariaDB ----
# cPanel: create the database + user in "MySQL Databases" (names get your cPanel prefix, e.g. cpuser_epson)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpuser_epson
DB_USER=cpuser_epson
DB_PASSWORD=
# ...or a single URL instead (URL-encode special characters in the password):
# DATABASE_URL=mysql://user:password@localhost:3306/dbname
DB_SSL=false
# Timestamps are stored and reported in this UTC offset (India = +05:30)
DB_TIMEZONE_OFFSET=+05:30

# ---- Auth ----
# Use a long random string:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- Calls ----
# How long a customer waits in queue before the call is marked "missed"
CALL_RING_TIMEOUT_SEC=120

# ---- WebRTC ICE servers ----
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# A TURN server is strongly recommended in production (mobile networks / strict NATs).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Seed (npm run db:seed) ----
SEED_ADMIN_NAME=Epson Admin
SEED_ADMIN_EMAIL=admin@epson.local
SEED_ADMIN_PASSWORD=Admin@123
# true = also create demo agents (password Agent@123) and demo stores
SEED_DEMO_DATA=false
