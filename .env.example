# Local development settings. Copy to .env (never commit .env).
# On Render the same variables are set in the dashboard (see render.yaml).

PORT=4000
NODE_ENV=development
# Frontend origins allowed to call the API, comma-separated.
# "*" works as a wildcard inside a host name, e.g. https://epson-connect*.vercel.app (also covers Vercel preview URLs)
CORS_ORIGINS=https://localhost:5173,https://localhost:5174,http://localhost:5173,http://localhost:5174

# ---- Database: Neon PostgreSQL ----
# Neon console -> your project -> Connect -> copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Used for "today", daily charts and date filters
DB_TIMEZONE=Asia/Kolkata

# ---- Auth ----
# Long random string:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- Start-up ----
# Tables are created/updated automatically on start, and the first admin is created from SEED_ADMIN_*.
AUTO_SETUP=true
SEED_ADMIN_NAME=Epson Admin
SEED_ADMIN_EMAIL=admin@epson.local
SEED_ADMIN_PASSWORD=Admin@123
# npm run db:seed with SEED_DEMO_DATA=true also adds demo experts (password Agent@123) and demo stores
SEED_DEMO_DATA=false

# ---- Calls ----
# How long a customer waits in queue before the call is marked "missed"
CALL_RING_TIMEOUT_SEC=120

# ---- WebRTC ICE servers ----
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relay - strongly recommended in production (mobile networks / strict NATs)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
